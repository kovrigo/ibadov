---
// Button (button-primary): a 1px gold frame on the dark, light label text, a 1px line arrow,
// as on the customer's frame. Hover fills it with gold. A plain link.
interface Props {
  href: string;
  label: string;
  /** Full width (the phone bar). */
  block?: boolean;
}
const { href, label, block = false } = Astro.props;
---

<a class:list={['button', 't-label', { 'button--block': block }]} href={href}>
  <span>{label}</span>
  <svg class="arrow" aria-hidden="true" focusable="false" width="26" height="10" viewBox="0 0 26 10">
    <path d="M0 5h25M20 .5 25 5l-5 4.5" fill="none" stroke="currentColor" stroke-width="1" vector-effect="non-scaling-stroke"></path>
  </svg>
</a>

<style>
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-xl);
    height: var(--button-height);
    padding: var(--button-padding);
    border: 1px solid var(--gold);
    background: transparent;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--radius);
    transition:
      background-color var(--dur-hover) linear,
      color var(--dur-hover) linear;
  }
  .button .arrow {
    color: var(--gold);
    transition: color var(--dur-hover) linear;
  }
  /* Only where a pointer hovers: after a tap a touch screen keeps :hover, and the frame would stay
     filled when the visitor comes back from Telegram. */
  @media (hover: hover) {
    .button:hover {
      background: var(--gold);
      color: var(--on-gold);
    }
    .button:hover .arrow {
      color: var(--on-gold);
    }
  }
  .button:active {
    transform: translateY(1px);
  }
  .button--block {
    display: flex;
    width: 100%;
    height: var(--button-height-block);
    justify-content: space-between;
    padding-inline: var(--space-lg);
  }
  .arrow {
    flex: none;
  }
  /* Screens narrower than 1.55:1 leave the text column less room before the face: a tighter frame. */
  @media (orientation: landscape) and (max-aspect-ratio: 155/100) {
    .button:not(.button--block) {
      gap: var(--space-md);
      padding: var(--button-padding-compact);
      letter-spacing: 0.2em;
    }
  }
</style>
