---
// The intro overlay. It fills the hero's accent place: over the hero image, under the hero text,
// so the Telegram button stays visible and pressable from the first frame. Hidden from screen
// readers; hidden altogether unless the head script chose the intro. It holds the intro video
// (no sound, never looped, no controls). Nothing downloads unless the head chose the intro: then
// the inline script below starts the file for the screen shape (vertical in portrait).
import wide from './assets/intro-wide.mp4?url';
import vertical from './assets/intro-vertical.mp4?url';
---

<div class="opening" data-opening aria-hidden="true">
  <video
    class="opening__video"
    data-opening-video
    data-wide={wide}
    data-vertical={vertical}
    muted
    playsinline
    preload="none"
    disablepictureinpicture
    disableremoteplayback></video>
  <script is:inline>
    (function (v) {
      if (!v || !document.documentElement.classList.contains('intro-wait')) return;
      v.preload = 'auto';
      v.src = matchMedia('(orientation: portrait)').matches ? v.dataset.vertical : v.dataset.wide;
    })(document.querySelector('[data-opening-video]'));
  </script>
</div>

<style is:global>
  .opening {
    position: absolute;
    inset: 0;
    display: none;
    overflow: hidden;
    background: var(--ink);
    pointer-events: none;
  }
  .opening__video {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    opacity: 0;
  }
  @media (orientation: landscape) {
    /* As the hero's wide picture: one screen tall at the scene's top (story scene.css). */
    .opening {
      bottom: auto;
      height: 100svh;
    }
  }
  /* intro-wait (head script): the hero image waits under ink and the credit, headline, lead, nav
     and cue wait at opacity 0; the button and the phone bar stay. If no script takes over, CSS
     alone shows the first screen at 2.5 s. intro-on: the motion script drives the overlay.
     intro-fade: no intro, the headline fades in over 480ms. Reduced motion: none of this. */
  @media (prefers-reduced-motion: no-preference) {
    html.intro-wait .opening,
    html.intro-on .opening {
      display: block;
    }
    html.intro-wait .opening {
      animation: opening-out var(--dur-title) var(--ease-exit) 2.5s both;
    }
    html.intro-wait [data-scene='hero'] :is([data-part='credit'], [data-part='headline'], [data-part='lead'], [data-part='nav'], [data-part='cue']) {
      animation: opening-in var(--dur-title) var(--ease-enter) 2.5s both;
    }
    /* Its own keyframes: swapping intro-wait for intro-fade then starts a new 480ms fade
       instead of jumping to the end of the wait's animation. */
    html.intro-fade [data-scene='hero'] [data-part='headline'] {
      animation: opening-fade var(--dur-title) var(--ease-enter) both;
    }
  }
  @keyframes opening-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes opening-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes opening-out {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
</style>
