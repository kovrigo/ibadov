---
// The Landing screen: the six scenes in the Brief's order. Slots: "before-hero" (the opening
// overlay) and "accent-<scene>" for each scene; all empty at level 1. The phone bar (Contact's
// widget in the Frame's floating place) comes right after the hero, so the keyboard reaches it
// right after the hero text.
import './scene.css';
import Hero from './scenes/Hero.astro';
import Services from './scenes/Services.astro';
import Freeze from './scenes/Freeze.astro';
import Numbers from './scenes/Numbers.astro';
import Partners from './scenes/Partners.astro';
import Final from './scenes/Final.astro';
import { PhoneBar } from '../contact';
---

<main>
  <slot name="before-hero" />
  <Hero><slot name="accent-hero" slot="accent" /></Hero>
  <PhoneBar />
  <Services><slot name="accent-services" slot="accent" /></Services>
  <Freeze><slot name="accent-freeze" slot="accent" /></Freeze>
  <Numbers><slot name="accent-numbers" slot="accent" /></Numbers>
  <Partners><slot name="accent-partners" slot="accent" /></Partners>
  <Final><slot name="accent-final" slot="accent" /></Final>
</main>

<script>
  // Loading state (Brief «Состояния»): an image group shows only when all its images are ready,
  // then fades in (240ms, 200ms in the calm version — set in scene.css). Only this script hides
  // anything; without scripts the images simply appear as they load. A failed image keeps its
  // group on ink.
  for (const stack of document.querySelectorAll<HTMLElement>('[data-stack]')) {
    const imgs = [...stack.querySelectorAll('img')];
    const ready = () => imgs.every((img) => img.complete && img.naturalWidth > 0);
    if (ready()) continue;
    stack.dataset.loading = '';
    let failed = false;
    const settle = () => {
      if (!failed && ready()) delete stack.dataset.loading;
    };
    for (const img of imgs) {
      img.addEventListener('load', settle);
      img.addEventListener('error', () => {
        failed = true;
      });
    }
  }
</script>
